# Screen text (stroke_gate). Keys are "stroke_gate-" plus a short name from the English text; tooltip keys end in -tip.

stroke_gate-no-layer-to-paint-on = No layer to paint on.
stroke_gate-this-face-belongs-to-another = This face belongs to another texture set, { $name }.
stroke_gate-smudge-and-clone-do-not = Smudge and clone do not work with symmetry
stroke_gate-cannot-paint = Cannot paint
stroke_gate-cannot-paint-on-this-layer = Cannot paint on this layer
stroke_gate-the-channel-is-off-on = The { $channel } channel is off on this layer.
