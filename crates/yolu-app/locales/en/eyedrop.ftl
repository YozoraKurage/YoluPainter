# Screen text (eyedrop). Keys are "eyedrop-" plus a short name from the English text; tooltip keys end in -tip.

eyedrop-nothing-of-the-model-under = Nothing of the model under the pointer
eyedrop-no-texture-set-for-this = No texture set for this surface
eyedrop-this-surface-s-uv-is = This surface's UV is outside the texture
eyedrop-nothing-to-pick-there-transparent = Nothing to pick there (transparent).
eyedrop-text = ,{" "}
eyedrop-picked = Picked
eyedrop-pick-from-the-composite-instead-tip = Pick from the composite instead of the selected layer
eyedrop-sample-all-layers = Sample All Layers
