m2_menu-clamp = 夾取
m2_menu-wrap-tiling = 環繞（拼貼）
m2_menu-rename = 重新命名
m2_menu-duplicate = 製作副本
m2_menu-register-these-settings = 登錄此設定
m2_menu-revert = 還原
m2_menu-delete = 刪除
m2_menu-round-hardness = 圓形（硬度）
m2_menu-none = 無
m2_menu-paint-this-channel = 設為繪製的通道
m2_menu-show-in-canvas = 在畫布中顯示
m2_menu-delete-channel = 刪除通道
