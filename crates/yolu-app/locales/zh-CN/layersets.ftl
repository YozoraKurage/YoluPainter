# 界面文本（layersets）。键名为“layersets-”加上取自英文的简短名称，工具提示的键名以 -tip 结尾。

layersets-layer-set = 图层集
layersets-material = 材质
layersets-invalid-layer-set-name = 无法使用此图层集名称。
layersets-another-layer-set-is-already = 已有名为“{ $name }”的图层集。
layersets-the-last-layer-set-cannot-be-removed = 无法删除最后一个图层集。
layersets-new-layer-set = 新建图层集
layersets-move-to-layer-set = 移至图层集
layersets-no-output-tip = 无输出
layersets-output-layer-set-tip = 输出来源的图层集
layersets-add-tip = 添加
layersets-add-texture-set = 添加纹理集
layersets-add-layer-set = 添加图层集
layersets-the-output-of-was-removed = { $set } 不再使用 { $channel }，因此已移除 { $channel } 的输出来源。
layersets-cannot-paint-channel = 无法绘制 { $name }
layersets-no-layer-set-uses-the-channel = 没有图层集使用此通道
layersets-no-room-for-a-channel-set = 图层集已达上限（{ $max }），因此未为通道创建专用的图层集即添加。
layersets-the-set-has-no-channels = { $set } 已没有任何通道。
