# 界面文本（export）。键名为“export-”加上取自英文的简短名称，工具提示的键名以 -tip 结尾。

export-no-export-template = 没有导出模板“{ $id }”。
export-exporting = 正在导出
export-not-padded-because-the-3d = 3D 视图中没有模型，无法得知 UV，因此未进行边缘扩展
export-is-not-padded-because-its = “{ $set }”的材质没有 UV 三角形，因此未进行边缘扩展
export-the-ao-of-is-stale = “{ $set }”的 AO 已过时，因此不使用
export-a-set-without-a-current = 没有最新 AO 烘焙的纹理集，其屏蔽为白色（无屏蔽）
export-read-only-set-was-not = 未导出只读的纹理集“{ $set }”
export-inactive-effect-s-of-are = “{ $set }”中有 { $effects } 个未生效的效果未包含在导出的图片中
export-there-is-no-texture-set = 没有可导出的纹理集。
export-cannot-copy-texture-set = 无法复制纹理集“{ $name }”
export-nothing-to-export-for-because = 没有任何图层使用“{ $name }”读取的通道，因此没有可导出的内容
export-nothing-was-exported-because-these = 这些图片会写入相同的文件，因此未导出任何内容
export-text = 、
export-nothing-to-export-because-no = 没有任何图层使用任何通道，因此没有可导出的内容
export-export-canceled-nothing-was-written = 已取消导出（未写入任何内容）。
export-canceling-the-export = 正在取消导出…
export-an-export-is-running = 正在导出。
export-confirm-replacing-existing-file-s = 确认是否替换 { $existing } 个现有文件。
export-channels = 通道
export-confirm-replacing-1-existing-file = 确认是否替换 1 个现有文件。
export-no-file-to-write-to = 没有要写入的文件。
export-cannot-export = 无法导出
export-exporting-2 = 正在导出：{ $label }…
export-exporting-images = 正在导出：{ $label }（{ $total } 张图片）…
export-the-export-stopped = 导出已中止
export-exported-image-s-to = 已导出 { $images } 张图片（{ $template }）至 { $dir }。
export-exported = 已导出 { $path }。
export-export-canceled-no-file-was = 已取消导出（未更改任何文件）。
export-current-channel = 当前的通道
export-per-channel = 每个通道
export-there-is-no-destination = 没有输出位置。
export-export-the-channel-as-png = 将通道导出为 PNG
export-folder-for-the-exported-images = 导出图片的文件夹
export-linear = 线性
export-overwrite-tip = 覆盖
export-export-textures = 导出纹理
export-close-window = 关闭窗口
export-texture-sets = 纹理集
export-output-path = 输出位置
export-choose = 选择…
export-output-template = 输出模板
export-padding = 边缘扩展
export-files-to-export = 要导出的文件
export-an-export-is-running-2 = 正在导出
export-no-output-path = 未选择输出位置
export-cancel = 取消
export-export = 导出
