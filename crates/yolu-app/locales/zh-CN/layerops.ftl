# 界面文本（layerops）。键名为“layerops-”加上取自英文的简短名称，工具提示的键名以 -tip 结尾。

layerops-transparent-pixels = 透明像素
layerops-image-pixels = 图像像素
layerops-position = 位置
layerops-all = 全部
layerops-lock-transparent-pixels = 锁定透明像素
layerops-lock-image-pixels = 锁定图像像素
layerops-lock-position = 锁定位置
layerops-lock-all = 全部锁定
layerops-filters-and-generators-baked-into = 滤镜与生成器已烘焙成像素
layerops-paths-became-pixels = 路径已转为像素
layerops-hidden-children-dropped = 已略过隐藏的子项目
layerops-pixels-of-disabled-channels-dropped = 已略过停用通道的像素
layerops-text-became-pixels = 文本已转为像素
layerops-text = ；
layerops-merged = 已合并
layerops-merged-into = 已合并至 { $name }
layerops-merge-cancelled = 已取消合并。
layerops-cannot-delete-the-last-layer = 无法删除最后一个图层。
layerops-all-locks = 所有锁定
layerops-text-2 = 、
layerops-locked = 已锁定：{ $what }
layerops-unlocked = 已解除锁定：{ $what }
layerops-no-layer-with-pixels-to = 没有含可移动像素的图层。
layerops-no-pixels-to-move-inside = 选区内没有可移动的像素。
layerops-no-pixels-to-move = 没有可移动的像素。
layerops-moved = 已移动。
layerops-rotated-90-clockwise = 已顺时针旋转 90°。
layerops-rotated-90-counter-clockwise = 已逆时针旋转 90°。
layerops-flipped-horizontally = 已水平翻转。
layerops-flipped-vertically = 已垂直翻转。
layerops-scale-must-not-be-0 = 缩放比例不可为 0%。
layerops-transformed = 已变形。
layerops-cannot-move-a-text-layer = 无法移动文本图层
layerops-it-cannot-move-only-inside = 无法只移动选区内的部分
layerops-cannot-move-a-text-layer-2 = 无法移动文本图层
layerops-nothing-changed = 没有任何更改。
