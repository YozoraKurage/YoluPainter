# 界面文本（psd）。键名为“psd-”加上取自英文的简短名称，工具提示的键名以 -tip 结尾。

psd-cancelled = 已取消
psd-cancelled-nothing-was-written = 已取消（未写入任何内容）
psd-the-psd-job-stopped = PSD 处理已中止
psd-cannot-read-back-the-psd = 无法读回要写入的 PSD
psd-failed-partway-through-replacing-earlier = 替换途中失败（{ $cause }）。先前的 { $done } 个文件已被替换。
psd-canvas-too-large = 画布过大（{ $width }×{ $height }）
psd-canvas-side-too-long-up = 画布边长过长（{ $width }×{ $height }；每边最多 { $limit }）
psd-too-many-layers-limit = 图层过多（{ $value } 个；上限 { $limit } 个）
psd-layer-memory-budget-exceeded-at = 在“{ $layer }”超过图层内存上限
psd-writing-would-make-the-psd = 写入“{ $layer }”会使 PSD 超过 2 GiB
psd-a-psd-file-is-limited-tip = PSD 文件上限为 2 GiB
psd-a-psd-side-is-limited-tip = PSD 每边上限为 30000 像素
psd-the-limit-follows-layer-memory-tip = 上限取决于设置中的“图层内存”（每个组也会占用一笔分隔记录）。调高后或许就能导出
psd-the-limit-follows-layer-memory-2-tip = 上限取决于设置中的“图层内存”。调高后或许就能导出
psd-reading-psd = 正在读取 PSD
psd-writing-psd = 正在写入 PSD
psd-psd-import-canceled = 已取消导入 PSD。
psd-psd-export-canceled = 已取消导出 PSD。
psd-canceling-the-psd-job = 正在取消 PSD 处理…
psd-a-psd-job-is-running = PSD 正在处理中。
psd-cannot-read-the-psd = 无法读取 PSD
psd-reading-psd-2 = 正在读取 PSD：{ $file }
psd-cannot-export-psd = 无法导出 PSD
psd-cannot-export-nothing-was-written = 无法导出。未写入任何内容
psd-the-channel-file-name-clashes = 通道文件名{ $name }重复
psd-writing-psd-2 = 正在写入 PSD：{ $file }
psd-cannot-import-the-psd = 无法导入 PSD
psd-cannot-import-the-file-was = 无法导入。文件未被修改
psd-read-waiting-for-the-import = 已读取 { $file }（等待导入确认）
psd-wrote-psd-bytes = 已写入 PSD：{ $path }（{ $bytes } 字节）。
psd-wrote-psds = 已写入 { $many } 个 PSD：{ $dir }
psd-finished-reading-while-drawing-so = { $file } 在你绘制时读取完成，因此未导入。
psd-the-project-changed-while-reading = 读取期间项目已更改，因此未导入 { $file }。
psd-imported-layers-the-psd-itself = 已导入 { $file }（{ $layers } 个图层）。PSD 本身不会被改写。
psd-not-switched-to-it-while = {" "}绘制中，因此未切换过去。
psd-the-file-has-no-name = 文件没有名称
psd-is-not-a-regular-file = { $path }不是普通文件
psd-the-written-file-does-not = 写入的文件读回时内容不一致
psd-pixel-budget-exceeded = 超过像素上限
psd-layer-extra-data-exceeds-the = 图层的额外数据超过上限
psd-the-psd-would-exceed-2 = PSD 会超过 2 GiB
